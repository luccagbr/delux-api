{
    "compilerOptions": {
        "lib": ["ESNext.Array", "ESNext.Collection", "ESNext.Promise"],
        "module": "nodenext",
        "target": "es2022",

        "noEmit": false,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node16",
        "outDir": "dist",
        "rootDir": "./src"
    }
}
